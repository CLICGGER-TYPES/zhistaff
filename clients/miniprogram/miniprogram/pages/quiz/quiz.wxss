.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 10rpx 0;
}
.q-num { font-size: 26rpx; color: var(--muted); flex: 1; }
.timer { font-size: 30rpx; font-weight: 700; color: var(--primary); }
.q-progress { font-size: 26rpx; color: var(--muted); }

.progress-track {
  height: 12rpx;
  background: var(--border);
  border-radius: 6rpx;
  overflow: hidden;
  margin: 12rpx 0;
}
.progress-track .fill {
  height: 100%;
  background: var(--primary);
  border-radius: 6rpx;
  transition: width .2s;
}

.q-text {
  font-size: 32rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  display: block;
  margin-bottom: 12rpx;
}
.q-img {
  width: 100%;
  margin: 16rpx 0;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
}
.q-desc {
  font-size: 26rpx;
  color: var(--muted);
  background: #f8fafc;
  border: 1rpx dashed var(--border);
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 12rpx 0;
  white-space: pre-wrap;
}

.option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 14rpx;
  margin: 16rpx 0;
}
.option.checked { border-color: var(--primary); background: #f0f6ff; }
.option.correct { border-color: var(--ok); background: #f0fdf4; }
.option.wrong { border-color: var(--bad); background: #fef2f2; }
.opt-key { font-weight: 600; color: var(--primary); min-width: 40rpx; }
.opt-val { flex: 1; white-space: pre-wrap; }

.fill-input {
  width: 100%;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.judge-btn { margin-top: 20rpx; }

.explain {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.explain-title { color: var(--warn); font-weight: 600; display: block; margin-bottom: 10rpx; }
.explain-correct, .explain-detail { white-space: pre-wrap; margin-top: 8rpx; }
.explain .b { font-weight: 600; }

.action-bar {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}
.action-bar.center { justify-content: center; }
.action-bar .btn { flex: 1; }
.action-bar.center .btn { flex: 0 0 auto; min-width: 220rpx; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 220rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid var(--border);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,.15);
  font-size: 48rpx;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.fab.active { border-color: #f59e0b; color: #f59e0b; background: #fffbeb; }
