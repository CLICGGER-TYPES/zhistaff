.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin: 10rpx 0;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 10rpx 0 24rpx;
}
.tab-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  background: #fff;
  color: var(--muted);
  font-size: 28rpx;
}
.tab-btn.active {
  border-color: var(--primary);
  color: var(--primary);
  background: #f0f6ff;
  font-weight: 600;
}

.session-item, .fav-item {
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}
.si-head { display: flex; justify-content: space-between; font-size: 28rpx; }
.bad-text { color: var(--bad); }
.si-tip { font-size: 24rpx; color: var(--muted); display: block; margin-top: 8rpx; }
.b { font-weight: 600; }
.badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 10rpx;
  background: #fee2e2;
  color: var(--bad);
}
.fi-head { display: flex; align-items: center; }
.fi-text { font-size: 28rpx; display: block; margin-top: 8rpx; }

.answer-sheet {
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 0;
}
.answer-sheet .grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.answer-sheet .cell {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #eef2f7;
  color: var(--text);
  border: 1rpx solid var(--border);
}
.answer-sheet .cell.ok { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
.answer-sheet .cell.bad { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
.answer-sheet .legend {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 24rpx;
}
.answer-sheet .dot {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
.answer-sheet .dot.ok { background: #6ee7b7; }
.answer-sheet .dot.bad { background: #fca5a5; }
.answer-sheet .dot.na { background: #eef2f7; border: 1rpx solid var(--border); }
