.result-box {
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 50rpx 32rpx;
  text-align: center;
  margin-top: 40rpx;
}
.r-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 24rpx; }
.score { font-size: 90rpx; font-weight: 700; display: block; }
.score.ok { color: var(--ok); }
.score.mid { color: var(--warn); }
.score.bad { color: var(--bad); }

.result-stats {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-top: 40rpx;
}
.stat { display: flex; flex-direction: column; align-items: center; }
.stat .num { font-size: 44rpx; font-weight: 700; }
.stat .lbl { font-size: 26rpx; color: var(--muted); margin-top: 6rpx; }

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
  flex-wrap: wrap;
}
.action-bar .btn { flex: 1; min-width: 200rpx; }
