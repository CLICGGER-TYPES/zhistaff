.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 0;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 10rpx 0 24rpx;
}
.tab-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  background: #fff;
  color: var(--muted);
  font-size: 28rpx;
}
.tab-btn.active {
  border-color: var(--primary);
  color: var(--primary);
  background: #f0f6ff;
  font-weight: 600;
}

.history-table {
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  overflow: hidden;
}
.ht-row {
  display: flex;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid var(--border);
  font-size: 24rpx;
  align-items: center;
}
.ht-head { color: var(--muted); font-weight: 500; }
.ht-row .c1 { flex: 2.2; }
.ht-row .c2 { flex: 1; }
.ht-row .c3 { flex: 1.2; }
.ht-row .c4 { flex: 1; }
.ht-row .c5 { flex: 1.4; }

.stat-box {
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.sb-title { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.chart { width: 100%; height: 480rpx; }

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 22rpx;
  margin: 14rpx 0;
}
.ri-info { font-size: 26rpx; flex: 1; }
.ri-meta { font-size: 22rpx; color: var(--muted); display: block; margin-top: 6rpx; }
.ri-rate { font-size: 28rpx; font-weight: 700; color: var(--bad); }
.b { font-weight: 600; }
